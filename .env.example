# Host ports
API_PORT=8000
MCP_PORT=8001

# Container storage
DB_PATH=/app/database/local/app.db
SNAPSHOT_DIR=/app/database/snapshots

# MCP to API
API_BASE_URL=http://api:8000
API_TIMEOUT_SECONDS=180

# Optional AI analysis; deterministic reference mode needs neither value.
OPENAI_API_KEY=
OPENAI_MODEL=
ANALYSIS_BATCH_SIZE=40
ANALYSIS_MAX_BATCHES=20

# Local PM frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
