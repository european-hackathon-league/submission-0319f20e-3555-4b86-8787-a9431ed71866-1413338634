# Allow only runtime Python and the two widget build entry points.
**
!mcp_server/
mcp_server/**
!mcp_server/*.py
!mcp_server/requirements.txt
!mcp_server/ui/
mcp_server/ui/**
!mcp_server/ui/package.json
!mcp_server/ui/package-lock.json
!mcp_server/ui/tsconfig.json
!mcp_server/ui/build.mjs
!mcp_server/ui/*.html
!mcp_server/ui/src/
mcp_server/ui/src/**
!mcp_server/ui/src/*.ts
!mcp_server/ui/src/*.css
!mcp_server/ui/src/shared/
mcp_server/ui/src/shared/**
!mcp_server/ui/src/shared/*.ts
!mcp_server/ui/src/shared/*.css
